# New document-assisted inventory demo (set real values in ignored .env.local)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/estock
GEMINI_API_KEY=
ESTOCK_GEMINI_MODEL=gemini-3.8-flash
# Optional: medium or high. Blank leaves image resolution to Gemini; it does not select a model.
ESTOCK_GEMINI_MEDIA_RESOLUTION=
ESTOCK_MANAGER_PASSWORD=
ESTOCK_STAFF_PASSWORD=
# Local development demo only; production still requires different account passwords.
ESTOCK_DEMO_ALLOW_SHARED_PASSWORD=false
ESTOCK_SESSION_SECRET=

# Legacy replenishment demo settings, retained for historical source
ESTOCK_DB_PATH=data/estock.sqlite
# Optional shared gate for synthetic demo sessions. This is not production identity.
ESTOCK_DEMO_ACCESS_CODE=
FORECAST_MODE=MOCK
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
CHRONOS_MODEL_REVISION=
FORECAST_ALLOW_FALLBACK=true
