{
  "name": "estock",
  "version": "0.1.0",
  "private": true,
  "description": "eStock persistent synthetic replenishment workflow.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "biome check src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --experimental-strip-types scripts/database.ts",
    "db:seed": "node --experimental-strip-types scripts/database.ts --seed",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:worker": "python3 -m unittest discover -s worker -p 'test_*.py'"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
